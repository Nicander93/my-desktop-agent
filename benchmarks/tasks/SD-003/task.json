      "package-lock.json"
    ],
    "commands": [
      {
        "command": "node",
        "args": [
          "harness/verify.mjs"
        ],
        "resolveArgsFromTaskDir": true,
        "expectedExitCode": 0,
        "stdoutIncludes": [
          "DWB_VERIFY_PASS"
        ],
        "timeoutMs": 120000
      }
    ]
  }
