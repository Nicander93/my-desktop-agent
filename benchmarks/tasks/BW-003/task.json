{
  "schemaVersion": 1,
  "id": "BW-003",
  "version": "1.0.0",
  "title": "Contract Obligation Register",
  "prompt": "从 input/contracts/*.txt 提取字段到 output/contract-register.xlsx、output/evidence.json（字段→文件:行号）、output/review-notes.md。缺失不补造。",
  "profile": "office",
  "capabilities": [
    "read-project",
    "transform-data",
    "inspect-spreadsheet",
    "validate-spreadsheet"
  ],
  "workflowId": "inspect-implement-run-verify",
