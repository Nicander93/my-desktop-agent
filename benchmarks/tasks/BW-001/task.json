{
  "schemaVersion": 1,
  "id": "BW-001",
  "version": "1.0.0",
  "title": "Expense Reconciliation",
  "prompt": "核对 input/expenses.csv 与 input/policy.json，在工作区根目录写出 exceptions.csv（expense_id,rule,reason；rule 为 meal_limit / missing_receipt / duplicate_receipt）与 summary.md（总笔数、总金额、异常数、按规则汇总）。不要修改 input/。",
  "profile": "office",
  "capabilities": [
    "read-project",
    "transform-data",
    "inspect-spreadsheet"
  ],
  "workflowId": "inspect-implement-run-verify",
  "suite": "quality",
  "tags": [
    "dwb",
    "business-workflow",
    "D2"
  ],
  "fixture": "fixture",
  "limits": {
    "maxTurns": 24,
    "timeoutMs": 600000,
    "maxChangedFiles": 10
  },
  "verifier": {
    "requiredFiles": [
      "exceptions.csv",
      "summary.md"
    ],
    "unchangedPaths": [
      "input/expenses.csv",
      "input/policy.json"
    ],
    "commands": [
      {
        "command": "node",
        "args": [
          "harness/verify.mjs"
        ],
        "resolveArgsFromTaskDir": true,
        "expectedExitCode": 0,
        "stdoutIncludes": [
          "DWB_VERIFY_PASS"
        ],
        "timeoutMs": 120000
      }
    ]
  }
}
