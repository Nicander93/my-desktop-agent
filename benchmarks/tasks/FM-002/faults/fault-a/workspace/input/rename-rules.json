{
  "sourceDir": "input/inbox",
  "targetPattern": "{date}_{seq}_{slug}.{ext}",
  "fallbackDate": "2024-01-01",
  "sequenceStart": 1,
  "sequenceWidth": 3,
  "monthMap": {
    "jan": "01", "feb": "02", "mar": "03", "apr": "04",
    "may": "05", "jun": "06", "jul": "07", "aug": "08",
    "sep": "09", "oct": "10", "nov": "11", "dec": "12"
  },
  "slugRules": {
    "lowercase": true,
    "replaceSpaces": "_",
    "stripCopySuffix": true
  }
}
