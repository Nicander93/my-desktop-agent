{
  "schemaVersion": 1,
  "id": "CW-001",
  "version": "1.0.0",
  "title": "Sales Reporting Pipeline",
  "prompt": "清洗 input/sales-raw.csv（去空白、数值化 amount），生成 sales-report.xlsx、sales-review.pptx、consistency.json。三处 total 必须一致。",
  "profile": "office",
  "capabilities": [
    "read-project",
    "transform-data",
    "inspect-spreadsheet",
    "create-pptx",
    "validate-pptx"
  ],
  "workflowId": "inspect-implement-run-verify",
  "suite": "quality",
  "tags": [
    "dwb",
    "cross-application",
    "D3"
  ],
  "fixture": "fixture",
  "limits": {
    "maxTurns": 30,
    "timeoutMs": 900000,
    "maxChangedFiles": 30
  },
  "verifier": {
    "requiredFiles": [
      "output/sales-report.xlsx",
      "output/sales-review.pptx",
      "output/consistency.json"
    ],
    "unchangedPaths": [
      "input/sales-raw.csv"
    ],
    "commands": [
      {
        "command": "node",
        "args": [
          "harness/verify.mjs"
        ],
        "resolveArgsFromTaskDir": true,
        "expectedExitCode": 0,
        "stdoutIncludes": [
          "DWB_VERIFY_PASS"
        ],
        "timeoutMs": 120000
      }
    ]
  }
}
